{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homegeneratorguide-www",
  "main": "workers/www-redirect.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.homegeneratorguide.com/*", "zone_name": "homegeneratorguide.com" }],
  "observability": { "enabled": true },
  "env": {
    "prelaunch": {
      "name": "homegeneratorguide-www",
      "workers_dev": false,
      "preview_urls": false,
      "routes": []
    }
  }
}
