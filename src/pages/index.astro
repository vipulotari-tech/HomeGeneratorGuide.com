---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemDiagram from '../components/diagrams/SystemDiagram.astro';
import {MODEL_SPECS} from '../data/model-specs';
import {SITE_URL} from '../config/site';
const steps=[['01','Define your backup needs','Choose the circuits and equipment you need during an outage.','/guides/first-time-buyer-guide/'],['02','Build a load plan','Use nameplate running and starting requirements.','/planning/sizing/'],['03','Understand the fuel supply','Compare consumption, local prices and outage constraints.','/planning/fuel/'],['04','Compare exact configurations','Check fuel-specific output, transfer equipment and evidence gaps.','/models/'],['05','Understand installation','Plan site assessment, utility coordination and approvals.','/installation/what-to-expect/'],['06','Understand the budget','Separate equipment price from the complete installation.','/cost/standby-generator-cost/'],['07','Compare three proposals','Make missing scope visible before comparing totals.','/planning/quotes/'],['08','Plan ownership','Budget maintenance, fuel, monitoring and repairs.','/planning/ownership/'],['09','Investigate what can go wrong','Separate documented issues from unsupported reliability claims.','/research/evidence-ledger/'],['10','Verify before signing','Confirm local approvals, qualified trades and service support.','/installation/state-research/']];
---
<BaseLayout title="Whole House Generator Guide: Sizing, Cost & Installation" description="Independent whole house generator research for US homeowners covering sizing, installed cost, brands, fuel, installation, exact models and quote comparison." schema={{'@context':'https://schema.org','@type':'WebSite',name:'HomeGeneratorGuide',url:SITE_URL+'/'}}>
<section class="publication-hero"><div class="editorial-container hero-grid"><div><p class="eyebrow">INDEPENDENT RESEARCH · US HOMEOWNERS</p><h1>Plan a whole house generator before the dealer call.</h1><p class="lede">Compare whole house generator sizing, installed cost, fuel options, exact standby models, transfer equipment and installer quote scope before you buy.</p><div class="planner-actions"><a class="button" href="/planning/sizing/">Start whole house generator sizing →</a><a class="button secondary" href="/planning/quotes/">Compare installer quotes</a></div></div><aside class="research-note"><p class="eyebrow">WHAT YOU CAN CHECK HERE</p><h2>Evidence you can follow.</h2><p>Manufacturer facts, planning assumptions and unresolved questions are kept separate. Every exact-model record links to its sources.</p><dl><div><dt>{MODEL_SPECS.length}</dt><dd>exact configurations, including package variants</dd></div><div><dt>5</dt><dd>manufacturers covered; depth varies</dd></div><div><dt>4</dt><dd>tools for load, fuel, quotes and ownership</dd></div></dl><p class="help">Research-based guidance. No hands-on generator testing. Technical professional review pending.</p><a href="/review-process/">How our review process works →</a></aside></div></section>
<section class="editorial-container publication-section"><div class="section-heading"><p class="eyebrow">YOUR PURCHASE PLAN</p><h2>Your next decision, clearly explained.</h2><p>Start where you are. Bring the results to a qualified installer for a property-specific assessment.</p></div><details open><summary>Show the ten-step purchase plan</summary><ol class="journey-list">{steps.map(([n,title,description,href])=><li><span aria-hidden="true">{n}</span><div><h3><a href={href}>{title} →</a></h3><p>{description}</p></div></li>)}</ol></details></section>
<section class="publication-band"><div class="editorial-container split-feature"><div><p class="eyebrow">THE SYSTEM, NOT JUST THE BOX</p><h2>Generator size is only one part of the purchase.</h2><p>Transfer equipment, managed loads, fuel capacity and installation scope determine what the system can support. A “whole-house” label does not settle those questions.</p><ul class="editorial-links"><li><a href="/installation/automatic-transfer-switch-guide/">Understand ATS and load management →</a></li><li><a href="/cost/standby-generator-cost/">Whole house generator cost guide →</a></li><li><a href="/brands/">Compare whole house generator brands →</a></li><li><a href="/models/">Browse exact models →</a></li></ul></div><SystemDiagram/></div></section>
<section class="editorial-container publication-section"><div class="split-feature"><div><p class="eyebrow">THE QUOTE DESK</p><h2>Compare the work behind the price.</h2><p>Put three proposals side by side. Identify missing fuel work, utility coordination, accessories and warranty scope. Add your own documented adjustments without pretending that the lowest price is automatically the best proposal.</p><a class="button" href="/planning/quotes/">Open the three-quote comparison →</a></div><div class="research-note"><h3>Before you sign, ask:</h3><ul class="editorial-links"><li>What is the exact generator and ATS model?</li><li>Which loads are backed up, and which must wait?</li><li>Who pays for gas capacity or electrical upgrades?</li><li>What is excluded from installation and service?</li></ul><a href="/cost/standby-generator-quote-checklist/">Read the full quote checklist →</a></div></div></section>
</BaseLayout>
