{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homegeneratorguide-production",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "homegeneratorguide.com/*",
      "zone_name": "homegeneratorguide.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "prelaunch": {
      "name": "homegeneratorguide-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": []
    }
  }
}
