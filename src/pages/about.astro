---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { MISSION, INDEPENDENCE, AUTHOR, SITE_URL } from '../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Standby Generator Guide',
  url: `${SITE_URL}/`,
  description: 'Independent, source-cited home standby generator education for American homeowners.',
  logo: `${SITE_URL}/logo.svg`,
};
---
<BaseLayout title="About Standby Generator Guide" description="Honest standby generator advice for American homeowners. Our mission, independence, research method, and transparent electrician-review standard." schema={schema}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'About' }]} />
    <h1 class="mt-4 text-4xl font-bold text-primary">Good advice before a big decision.</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink">You shouldn't need to become an electrician to make a confident choice about backup power. You do need someone to explain the tradeoffs honestly.</p>
    <figure class="my-6">
      <img src="/images/home-daytime.webp" alt="Suburban American home in daylight" width="1536" height="1024" loading="lazy" decoding="async" class="w-full rounded-xl border border-[#e5e7eb]" />
      <figcaption class="mt-2 text-sm text-gray-600">Illustrative photo.</figcaption>
    </figure>
    <div class="prose-hgg mt-6">
      <h2>Our mission</h2>
      <p>{MISSION}</p>
      <h2>Who we're here for</h2>
      <p>American homeowners researching their first home standby generator. Maybe you've lived through a long outage. Maybe you're worried about making an expensive mistake. Start with your questions; you don't need to know the jargon.</p>
      <p>Our guides help you work through the decisions in order: what to keep running, which fuel fits your property, how to read a quote, who should install the system, and what ownership involves.</p>
      <h2>Whose side we're on</h2>
      <p>{INDEPENDENCE}</p>
      <p>We don't sell generators or installer leads. No company can buy a better ranking, a favorable comparison, or silence about a limitation. Our <a href="/affiliate-disclosure/">funding disclosure</a> explains the current position.</p>
      <h2>What you'll find here</h2>
      <ul>
        <li><a href="/guides/first-time-buyer-guide/">A first-time buyer's guide</a> that puts the decisions in a sensible order.</li>
        <li><a href="/sizing/what-size-generator-do-i-need/">Sizing explanations</a> based on electrical loads and worked examples.</li>
        <li><a href="/cost/standby-generator-cost/">Cost guides</a> that separate equipment, labor, permits, fuel, and service.</li>
        <li><a href="/brands/">Brand research</a> and <a href="/comparisons/">comparisons</a> that explain both strengths and limitations.</li>
        <li><a href="/installation/what-to-expect/">Installation</a> and <a href="/maintenance/generator-maintenance-checklist/">maintenance</a> guidance so you can ask qualified professionals better questions.</li>
      </ul>
      <h2>Research and professional review</h2>
      <p>Research is credited to topic-specific desks within the <a href={AUTHOR.url}>{AUTHOR.name}</a>. We use manufacturer specifications, government and safety sources, and clearly labeled estimates. These editorial desk labels are not individual experts or professional credentials.</p>
      <p><strong>No independent licensed professional review has been completed.</strong> Our sources and editorial research should not be mistaken for professional signoff. Read the <a href="/review-process/">current review status</a> and the <a href="/editorial-policy/">editorial policy</a> for more information.</p>
      <h2>Help us keep it accurate</h2>
      <p>If something looks wrong, <a href="/contact/">send the page URL and the source that supports your correction</a>. We'll check it and explain material changes. Your own installer and local permitting office remain the right people to confirm requirements for your property.</p>
    </div>
  </div>
</BaseLayout>
