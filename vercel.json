{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/author/vipul-otari",
      "destination": "/editorial-team/",
      "permanent": true
    },
    {
      "source": "/author/vipul-otari/",
      "destination": "/editorial-team/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.homegeneratorguide.com"
        }
      ],
      "destination": "https://homegeneratorguide.com/:path*",
      "permanent": true
    },
    {
      "source": "/sizing/calculator",
      "destination": "/sizing/what-size-generator-do-i-need/",
      "permanent": true
    },
    {
      "source": "/sizing/calculator/",
      "destination": "/sizing/what-size-generator-do-i-need/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
