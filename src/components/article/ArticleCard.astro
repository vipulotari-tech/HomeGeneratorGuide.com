---
interface Props {
  href: string;
  title: string;
  description: string;
  category?: string;
  readingTime?: string;
}
const { href, title, description, category, readingTime } = Astro.props;
---
<article class="library-card">
  <div class="library-card-overline">
    <p>{category ?? 'Research guide'}</p>
    {readingTime && <span>{readingTime}</span>}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p class="library-card-description">{description}</p>
  <a href={href} class="library-card-action" aria-label={`Read guide: ${title}`}>Read guide <span aria-hidden="true">↗</span></a>
</article>
