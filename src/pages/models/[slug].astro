---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { MODEL_SPECS, type ModelSpec } from '../../data/model-specs';

export function getStaticPaths() {
  return MODEL_SPECS.map(model => ({params:{slug:model.slug},props:{model}}));
}

interface Props { model: ModelSpec; }
const { model } = Astro.props;
const ratingBits = [
  model.ratingsKw.LP !== undefined ? model.ratingsKw.LP + ' kW LP' : null,
  model.ratingsKw['Natural gas'] !== undefined ? model.ratingsKw['Natural gas'] + ' kW natural gas' : null,
].filter(Boolean);
const ratingSummary = ratingBits.length
  ? ratingBits.join(' / ')
  : model.standbyRatingKw !== undefined
    ? model.standbyRatingKw + ' kW published standby rating'
    : 'Fuel-specific output not established in current source set';
const brandHref =
  model.brand === 'Generac' ? '/brands/generac/' :
  model.brand === 'KOHLER / Rehlko' ? '/brands/kohler/' :
  model.brand === 'Champion' ? '/brands/champion/' :
  model.brand === 'Briggs & Stratton' ? '/brands/briggs-stratton/' :
  model.brand === 'Cummins' ? '/brands/cummins/' :
  '/brands/';
const modelDecisionNotes: Record<string, { heading: string; points: string[] }> = {
  G0072600: {
    heading: 'What stands out about this 22 kW Generac record',
    points: [
      'The cited record separates output by fuel: 22 kW on LP and 21 kW on natural gas, so the fuel choice changes the published standby rating.',
      'It shares the same published enclosure dimensions and G-Force 1000 engine family as the cited 26 kW G0073270, but the two records have different output, weight, fuel-use points, and starting MSRP.',
      'The exact G0072600 product page does not establish an included transfer switch. A dealer bundle should identify the switch separately in writing.',
    ],
  },
  G0073270: {
    heading: 'What stands out about this 26 kW Generac record',
    points: [
      'The cited record publishes 26 kW on LP and 24 kW on natural gas and includes both 50% and 100% load fuel-consumption test points.',
      'Its published enclosure dimensions match the cited G0072600 record while published weight is higher; that is a product-spec difference, not evidence of durability or installation quality.',
      'The product page does not establish an included ATS even though family documentation describes bundled configurations, so quote scope matters.',
    ],
  },
  '26RCA': {
    heading: 'Why 26RCA and 26RCAL should not be treated as the same package',
    points: [
      'The manufacturer identifies 26RCAL as an ATS package, but the 26RCA page contradicts itself about switch inclusion. Confirm the purchased configuration.',
      'The cited single-phase rating is 26 kW LP and 24 kW natural gas; the family sheet also covers other electrical configurations that should not be mixed into a residential single-phase comparison.',
      'Price comparisons should keep the unresolved-scope 26RCA starting MSRP separate from the 26RCAL package price and from any installed project quote.',
    ],
  },
  '26RCAL': {
    heading: 'What the ATS-inclusive 26RCAL package changes',
    points: [
      'The manufacturer identifies 26RCAL as the package that includes a 200 A service-entrance-rated RXT automatic transfer switch.',
      'Its published generator output matches the selected 26RCA single-phase record, so the important comparison is package scope rather than pretending the extra price buys more kW.',
      'The cited sound figures include manufacturer measurement caveats; they are not an independent acoustic test against other brands.',
    ],
  },
  '201222': {
    heading: 'What stands out about the Champion aXis system',
    points: [
      'This cited product is explicitly a system with a 200 A aXis automatic transfer switch, which makes its package scope different from generator-only starting-price pages.',
      'The manufacturer publishes 22 kW on LP and 19.8 kW on natural gas and lists separate generator and ATS warranty terms.',
      'aXis load-management modules are described as separate accessories, so a “whole-house” quote should state module model numbers, quantities, and managed loads.',
    ],
  },
  '040786': {
    heading: 'What stands out about this Briggs & Stratton record',
    points: [
      'The cited PowerProtect record publishes 22 kW on both LP and natural gas, unlike several selected competitors whose published output changes by fuel.',
      'Its captured fuel-use figures are expressed in BTU/hr rather than gallons/hr or ft³/hr. Do not compare the raw numbers across units without explicit conversion assumptions.',
      'The exact generator page does not establish an included transfer switch, so ATS scope should be confirmed separately in a dealer proposal.',
    ],
  },
  RS20A: {
    heading: 'Why the Cummins RS20A page is deliberately more conservative',
    points: [
      'The accessible Cummins model summary establishes a 20 kW standby rating, but our current source set does not expose a complete fuel-specific rating table, sound figure, starting MSRP, or ATS bundle for this exact model.',
      'The warranty summary comes from Cummins family-level home-generator FAQ context covering its 13, 17, and 20 kW models; buyers should confirm the exact warranty document for the purchased unit.',
      'Those missing fields are shown as gaps instead of being filled from a reseller, a different QuietConnect model, or another configuration.',
    ],
  },
};
const decisionNotes = modelDecisionNotes[model.modelId];
const checkDate=model.lastSourceCheck ?? model.sources[0].checkedOn;

const toc = [
  { id: 'snapshot', label: 'Model snapshot' },
  ...(decisionNotes ? [{ id: 'decision-notes', label: 'What stands out' }] : []),
  { id: 'fuel', label: 'Fuel-use data' },
  { id: 'sound', label: 'Sound data' },
  { id: 'package', label: 'Price, ATS & warranty' },
  { id: 'limits', label: 'What the sources do not prove' },
  { id: 'quote', label: 'Questions for a quote' },
];
---
<ArticleLayout
  title={model.brand + ' ' + model.modelId + ': Exact-Model Standby Generator Guide'}
  description={'Manufacturer-linked guide to ' + model.brand + ' ' + model.modelId + ' covering ' + ratingSummary + ', fuel-use test points where published, sound conditions, price/package scope, warranty and source limitations.'}
  category="Models" categoryHref="/models/" published={model.publishedOn} updated={checkDate} verified={checkDate} image="/images/standby-front-neutral.webp" readingTime="7 min read" toc={toc}
  takeaways={[
    'This page is tied to exact model ' + model.modelId + '; values are not silently borrowed from another model in the same brand family.',
    ratingSummary + '. Fuel-specific ratings and test conditions still do not size a home by themselves.',
    'Manufacturer specifications describe the product; they do not prove field reliability, local service quality, installed price, or fit for a particular property.',
  ]}
  sources={model.sources.map((source) => ({ label: source.label, href: source.url, type: 'Manufacturer' as const, verified: source.checkedOn }))}
  related={[
    { href: brandHref, title: model.brand + ' brand guide', description: 'See the broader brand/model context and source limitations.', category: 'Brands' },
    { href: '/comparisons/five-brand-standby-generator-comparison/', title: 'Five-brand standby comparison', description: 'Compare selected exact models without turning the table into a universal winner.', category: 'Comparisons' },
    { href: '/cost/standby-generator-quote-checklist/', title: 'Quote checklist', description: 'Require the exact generator, ATS, fuel rating and inclusions in writing.', category: 'Cost' },
  ]}
>
  {model.evidenceNotes?.length && <section class="source-panel" aria-label="Evidence conflicts and scope notes"><h2>Evidence notes before you compare</h2><ul>{model.evidenceNotes.map(note=><li>{note}</li>)}</ul></section>}
  <section id="snapshot">
    <h2>Exact-model snapshot</h2>
    <p><strong>{model.brand} {model.modelId}</strong> — {model.displayName}. {model.configuration}</p>
    <div class="not-prose mt-5 overflow-x-auto rounded-xl border border-[#d9e0ea]">
      <table class="mobile-kv-table min-w-[700px] w-full border-collapse text-left text-sm">
        <caption class="sr-only">Manufacturer-published model snapshot for {model.brand} {model.modelId}</caption>
        <tbody class="divide-y divide-gray-200 text-gray-800">
          {model.family && <tr><th scope="row" class="bg-[#edf3fb] p-3">Product family</th><td class="p-3">{model.family}</td></tr>}
          <tr><th scope="row" class="w-56 bg-[#edf3fb] p-3 text-primary">Published standby output</th><td class="p-3">{ratingSummary}</td></tr>
          {model.engine && <tr><th scope="row" class="bg-[#edf3fb] p-3 text-primary">Engine</th><td class="p-3">{[model.engine.maker, model.engine.model, model.engine.displacementCc ? model.engine.displacementCc + ' cc' : null].filter(Boolean).join(' · ')}</td></tr>}
          {model.dimensionsIn && <tr><th scope="row" class="bg-[#edf3fb] p-3 text-primary">Dimensions</th><td class="p-3">{model.dimensionsIn.length} × {model.dimensionsIn.width} × {model.dimensionsIn.height} in (L × W × H)</td></tr>}
          {model.weightLb && <tr><th scope="row" class="bg-[#edf3fb] p-3 text-primary">Published weight</th><td class="p-3">{model.weightLb} lb</td></tr>}
          <tr><th scope="row" class="bg-[#edf3fb] p-3">Electrical configuration</th><td class="p-3">{model.electrical ? [model.electrical.voltage,model.electrical.phase,model.electrical.frequencyHz ? model.electrical.frequencyHz+' Hz':null].filter(Boolean).join(' · ') : 'Not established in current record'}</td></tr>
          <tr><th scope="row" class="bg-[#edf3fb] p-3">Enclosure</th><td class="p-3">{model.enclosure ?? 'Not established in current record'}</td></tr>
          <tr><th scope="row" class="bg-[#edf3fb] p-3 text-primary">Manufacturer page</th><td class="p-3"><a href={model.productUrl} rel="external noopener noreferrer" class="text-primary underline decoration-accent underline-offset-4">Open exact product page</a></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  {decisionNotes && (
    <section id="decision-notes">
      <h2>{decisionNotes.heading}</h2>
      <ul>{decisionNotes.points.map((point) => <li>{point}</li>)}</ul>
    </section>
  )}

  <section id="fuel">
    <h2>Fuel-use data: keep load and units attached</h2>
    {model.fuelConsumption?.length ? (
      <>
        <p>The current source registry contains the following manufacturer-published test points. These are not a household fuel forecast; actual consumption changes with electrical load, fuel conditions, setup and runtime.</p>
        <div class="not-prose mt-4 overflow-x-auto rounded-xl border border-[#d9e0ea]">
          <table class="mobile-card-table min-w-[620px] w-full border-collapse text-left text-sm">
            <caption class="sr-only">Published fuel-consumption points for {model.brand} {model.modelId}</caption>
            <thead class="bg-[#edf3fb] text-primary"><tr><th class="p-3">Fuel</th><th class="p-3">Load</th><th class="p-3">Published consumption</th></tr></thead>
            <tbody class="divide-y divide-gray-200">
              {model.fuelConsumption.map((row) => <tr><td class="p-3">{row.fuel}</td><td class="p-3">{row.loadPercent}%</td><td class="p-3">{row.amount.toLocaleString('en-US')} {row.unit}</td></tr>)}
            </tbody>
          </table>
        </div>
      </>
    ) : <p>No model-specific fuel-consumption test point is stored in the current accessible source set. We leave the field blank rather than copy a value from another model.</p>}
  </section>

  <section id="sound">
    <h2>Sound data: mode and measurement conditions matter</h2>
    {model.sound?.length ? (
      <ul>{model.sound.map((row) => <li><strong>{row.decibelsA} dB(A)</strong> — {row.condition}{row.distanceFt ? ', at ' + row.distanceFt + ' ft' : ', measurement distance not stated in the captured source'}{row.direction ? '; ' + row.direction : ''}.</li>)}</ul>
    ) : <p>No model-specific sound figure is stored in the current source set. A missing value is not evidence that the generator is louder or quieter than a competitor.</p>}
    <p>Manufacturer values are not an independent head-to-head acoustic test. Installation geometry, reflective surfaces, load and operating mode can change what a listener experiences.</p>
  </section>

  <section id="package">
    <h2>Price, transfer-equipment scope and warranty</h2>
    <p><strong>Starting price:</strong> {model.startingMsrpUsd !== undefined ? '$' + model.startingMsrpUsd.toLocaleString('en-US') + ' USD' : 'No current starting MSRP established in the captured manufacturer source.'}</p>
    {model.startingMsrpNote && <p>{model.startingMsrpNote}</p>}
    <p><strong>Transfer equipment:</strong> {model.transferSwitch ?? 'The current exact-model source record does not establish an included transfer switch. Confirm the package in the written quote.'}</p>
    <p><strong>Warranty summary:</strong> {model.warranty ?? 'No model-specific warranty summary is stored in the current source record; use the exact current warranty document.'}</p>
    {model.ats && <p><strong>Structured ATS record:</strong> Included: {model.ats.included===undefined?'Unknown':model.ats.included?'Yes':'No in this catalog configuration'} · Model: {model.ats.model??'Not verified'} · Amperage: {model.ats.amps??'Not verified'} · Service entrance: {model.ats.serviceEntranceRated===undefined?'Not verified':model.ats.serviceEntranceRated?'Yes':'No'}.</p>}
    <p><strong>Load management:</strong> {model.loadManagement??'Exact module compatibility and included accessories not verified.'}</p>
    <p><strong>Monitoring:</strong> {model.monitoring??'Exact monitoring hardware, connectivity and subscription terms not verified.'}</p>
    <p><strong>Cold-weather accessories:</strong> {model.coldWeather??'Exact accessory part numbers and operating conditions require manual verification.'}</p>
    <p><strong>Warranty hour limit:</strong> Only established where expressly included in the cited summary above; otherwise unknown.</p>
    <p>A product-page MSRP is not an installed-project price. Site work, ATS/service equipment, fuel work, electrical work, permits, load management, accessories, commissioning and local labor can materially change the total.</p>
  </section>

  <section id="field-evidence"><h2>Field-level source map</h2><p>Published facts below are attributed to the cited manufacturer source. A product document is not independent performance evidence. Missing fields remain unknown.</p><ul>{Object.entries(model.fieldSources??{}).filter(([key])=>Boolean(model[key as keyof ModelSpec])).map(([key,url])=><li><a href={url}>{key.replace(/([A-Z])/g,' $1')} — manufacturer source</a></li>)}</ul>{model.missingFields?.length && <p><strong>Current evidence gaps:</strong> {model.missingFields.map(key=>key.replace(/([a-z])([A-Z])/g,'$1 $2').toLowerCase()).join(', ')}.</p>}{model.documents&&<ul>{Object.entries(model.documents).map(([key,url])=><li><a href={url}>{key.replace(/([A-Z])/g,' $1')}</a> — linked manufacturer document; applicability and revision must be checked for the purchased unit.</li>)}</ul>}</section>
  <section id="limits">
    <h2>What the manufacturer sources do not prove</h2>
    <ul>
      <li>They do not establish field reliability or failure rate versus another brand.</li>
      <li>They do not prove the quality or availability of local dealer/service support.</li>
      <li>They do not size a specific home or prove that every desired load can run simultaneously.</li>
      <li>They do not convert starting MSRP into a complete installed quote.</li>
      <li>They do not make unlike sound-test conditions directly comparable.</li>
      <li>They do not replace the current installation/operator manuals, local code, utility/fuel requirements, or a qualified property-specific assessment.</li>
    </ul>
  </section>

  <section id="quote">
    <h2>Questions to put beside this exact model in a quote</h2>
    <ol>
      <li>Is <strong>{model.modelId}</strong> the exact generator being supplied, or can the contractor substitute another model?</li>
      <li>Which fuel and published standby rating are being used in the load analysis?</li>
      <li>What exact ATS / transfer-equipment model is included?</li>
      <li>Which load-management modules or accessories are included?</li>
      <li>Which current warranty documents apply to the generator and ATS?</li>
      <li>Who performs commissioning, scheduled service and warranty repairs locally?</li>
      <li>Which site, fuel, electrical and permit items are excluded or allowances?</li>
    </ol>
  </section>
</ArticleLayout>
