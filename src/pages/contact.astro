---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
---
<BaseLayout title="Contact" description="Contact HomeGeneratorGuide with corrections, source updates, or content requests. No sales or installation services.">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'Contact' }]} />
    <h1 class="mt-4 text-4xl font-bold text-[#1e3a5f]">Contact</h1>
    <div class="prose-hgg mt-6">
      <p>We welcome corrections, manufacturer-spec updates, and topic requests. We do <strong>not</strong> sell, install, or service generators — for quotes, contact licensed local installers.</p>
      <h2>Email</h2>
      <p><a href="mailto:hello@homegeneratorguide.com">hello@homegeneratorguide.com</a></p>
      <h2>Send a note</h2>
      <p class="text-sm text-gray-600">This form composes an email in your mail app — no data is stored on our servers (static site, no backend).</p>
      <form action="mailto:hello@homegeneratorguide.com" method="get" enctype="text/plain" class="mt-4 space-y-4 rounded-xl border border-[#e5e7eb] bg-[#f9fafb] p-5">
        <div>
          <label for="c-subject" class="block text-sm font-semibold text-[#1e3a5f]">Subject</label>
          <input id="c-subject" name="subject" type="text" required autocomplete="off" placeholder="Correction: sizing guide wattage…" class="mt-1 min-h-[44px] w-full rounded-lg border border-[#e5e7eb] bg-white px-3 py-2 text-[15px]" />
        </div>
        <div>
          <label for="c-body" class="block text-sm font-semibold text-[#1e3a5f]">Message</label>
          <textarea id="c-body" name="body" rows="5" required autocomplete="off" placeholder="Page URL, what is wrong, and your source…" class="mt-1 w-full rounded-lg border border-[#e5e7eb] bg-white px-3 py-2 text-[15px]"></textarea>
        </div>
        <button type="submit" class="inline-flex min-h-[44px] items-center rounded-lg bg-orange-600 px-6 font-semibold text-white hover:bg-orange-700">Compose email</button>
      </form>
      <h2>What to include</h2>
      <ul>
        <li>Page URL and the exact claim in question.</li>
        <li>Your source (manufacturer page, manual page number, code section).</li>
        <li>Whether we may follow up with questions.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
