---
interface Props { value: string; label: string; sub?: string; }
const { value, label, sub } = Astro.props;
---
<div class="rounded-lg border border-[#e5e7eb] bg-[#f9fafb] p-4 text-center">
  <p class="text-2xl font-bold text-[#1e3a5f]">{value}</p>
  <p class="mt-1 text-sm font-medium text-gray-700">{label}</p>
  {sub && <p class="mt-1 text-xs text-gray-500">{sub}</p>}
</div>
