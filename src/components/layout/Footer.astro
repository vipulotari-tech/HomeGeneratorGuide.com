---
import BrandLogo from './BrandLogo.astro';
import { MISSION, EDITORIAL_PROMISE, INDEPENDENCE, REVIEW_NOTE } from '../../config/site';

const year = new Date().getFullYear();

const planning = [
  { href: '/sizing/', label: 'Sizing Guide' },
  { href: '/cost/', label: 'Cost Guide' },
  { href: '/installation/', label: 'Installation' },
  { href: '/maintenance/', label: 'Maintenance' },
];

const research = [
  { href: '/brands/', label: 'Brands' },
  { href: '/models/', label: 'Exact Models' },
  { href: '/comparisons/', label: 'Comparisons' },
  { href: '/guides/', label: 'Buying Guides' },
  { href: '/guides/generator-glossary/', label: 'Glossary' },
];

const company = [
  { href: '/about/', label: 'About' },
  { href: '/editorial-team/', label: 'Editorial Team' },
  { href: '/editorial-policy/', label: 'Editorial Policy' },
  { href: '/affiliate-disclosure/', label: 'Affiliate Disclosure' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/terms-of-service/', label: 'Terms of Service' },
  { href: '/disclaimer/', label: 'Disclaimer' },
  { href: '/corrections-policy/', label: 'Corrections Policy' },
  { href: '/review-process/', label: 'Review Status' },
  { href: '/contact/', label: 'Contact' },
];

const trust = [
  {
    t: 'Independent educational resource',
    d: 'No paid rankings or sponsored verdicts',
    icon: 'M9 12l2 2 4-4m5.6-2.6A9 9 0 1 1 12 3a9 9 0 0 1 8.6 6.4z',
  },
  {
    t: 'No industry affiliation',
    d: 'No brand, dealer, or installer payments',
    icon: 'M18 12H6m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  },
  {
    t: 'Safety-first guidance',
    d: 'Licensed pros for electrical and gas work',
    icon: 'M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z',
  },
];

const linkCls =
  'footer-link inline-flex min-h-[44px] items-center text-sm text-slate-300 underline-offset-4 transition-colors';
---

<footer class="site-footer text-slate-200">
  <div class="footer-glow" aria-hidden="true"></div>

  <section class="footer-editorial border-b border-white/10" aria-labelledby="editorial-promise-heading">
    <div class="mx-auto grid max-w-6xl gap-5 px-4 py-10 sm:px-6 lg:grid-cols-2 lg:py-12">
      <div class="footer-panel">
        <p class="footer-kicker">Independent buyer research</p>
        <h2 class="mt-2 text-base font-semibold tracking-tight text-white">Our mission</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-100">{MISSION}</p>
        <p class="mt-4 text-sm leading-relaxed text-slate-300">{INDEPENDENCE}</p>
      </div>

      <div class="footer-panel">
        <p class="footer-kicker">Transparent standards</p>
        <h2 id="editorial-promise-heading" class="mt-2 text-base font-semibold tracking-tight text-white">Our editorial promise</h2>
        <blockquote class="mt-3 text-sm leading-relaxed text-slate-100">{EDITORIAL_PROMISE}</blockquote>
        <p class="footer-status mt-4 text-sm leading-relaxed text-slate-200">
          <strong class="text-white">Current review status:</strong> {REVIEW_NOTE}
        </p>
        <a
          href="/editorial-policy/"
          class="footer-policy-link mt-3 inline-flex min-h-[44px] items-center text-sm font-semibold text-white"
        >
          Read our sourcing and review standards <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" aria-label="Trust commitments">
    <ul class="mx-auto grid max-w-6xl gap-3 px-4 py-6 sm:grid-cols-3 sm:px-6 lg:py-7">
      {trust.map((x) => (
        <li class="footer-trust-card group flex items-start gap-3.5">
          <span
            aria-hidden="true"
            class="footer-trust-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d={x.icon} />
            </svg>
          </span>
          <span>
            <span class="block text-[15px] font-semibold tracking-tight text-white">{x.t}</span>
            <span class="mt-0.5 block text-[13px] leading-relaxed text-slate-300">{x.d}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:py-12">
    <div class="lg:pr-5">
      <a href="/" class="inline-flex min-h-[44px] items-center gap-2" aria-label="HomeGeneratorGuide home">
        <BrandLogo inverse />
      </a>
      <p class="mt-4 text-sm font-semibold text-white">Independent guides for US homeowners.</p>
      <p class="mt-2 max-w-xs text-[13px] leading-relaxed text-slate-300">
        Sizing, costs, installation, and maintenance explained in plain language — so you can compare proposals and hire qualified local installers with confidence.
      </p>
      <a href="/editorial-policy/" class={linkCls}>How we research <span aria-hidden="true" class="ml-1">→</span></a>
    </div>

    <nav aria-label="Planning guides">
      <p class="footer-heading">Planning</p>
      <span aria-hidden="true" class="footer-heading-rule"></span>
      <ul class="mt-3 space-y-0.5">
        {planning.map((t) => (
          <li><a href={t.href} class={linkCls}>{t.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Research guides">
      <p class="footer-heading">Research</p>
      <span aria-hidden="true" class="footer-heading-rule"></span>
      <ul class="mt-3 space-y-0.5">
        {research.map((t) => (
          <li><a href={t.href} class={linkCls}>{t.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Company and legal">
      <p class="footer-heading">Company</p>
      <span aria-hidden="true" class="footer-heading-rule"></span>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 sm:grid-cols-1">
        {company.map((t) => (
          <li><a href={t.href} class={linkCls}>{t.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="footer-signoff">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <div class="footer-signoff-rule" aria-hidden="true">
        <span></span>
      </div>

      <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap gap-2" aria-label="Editorial independence">
          <span class="footer-pill">Independent research</span>
          <span class="footer-pill">Source-backed specifications</span>
          <span class="footer-pill">No installer lead sales</span>
        </div>

        <div class="text-sm leading-relaxed text-slate-300 lg:text-right">
          <p class="font-medium text-slate-100">© {year} HomeGeneratorGuide.com — All rights reserved.</p>
          <p class="mt-0.5 text-xs text-slate-400">No generator-brand, dealer, or installer advertising.</p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(70rem 24rem at 50% -8rem, rgba(92, 137, 196, 0.22), transparent 72%),
      radial-gradient(36rem 22rem at 100% 40%, rgba(24, 69, 117, 0.2), transparent 78%),
      linear-gradient(180deg, #12325a 0%, #0c2545 45%, #081a31 100%);
    border-top: 1px solid rgba(218, 184, 112, 0.42);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    z-index: 2;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(218, 184, 112, 0.24) 20%,
      rgba(240, 210, 148, 0.9) 50%,
      rgba(218, 184, 112, 0.24) 80%,
      transparent 100%
    );
    pointer-events: none;
  }

  .footer-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    pointer-events: none;
    background:
      linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.035) 45%, transparent 68%),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.018) 0,
        rgba(255, 255, 255, 0.018) 1px,
        transparent 1px,
        transparent 8px
      );
  }

  .footer-panel {
    border: 1px solid rgba(255, 255, 255, 0.105);
    border-radius: 1rem;
    padding: 1.25rem;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .footer-kicker,
  .footer-heading {
    color: #e4c27a;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .footer-status {
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.75rem;
    background: rgba(4, 18, 35, 0.26);
    padding: 0.8rem 0.9rem;
  }

  .footer-policy-link {
    text-decoration-line: underline;
    text-decoration-color: rgba(228, 194, 122, 0.86);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .footer-policy-link:hover {
    color: #f9e5ba;
    text-decoration-color: #f9e5ba;
  }

  .footer-trust-card {
    border: 1px solid rgba(255, 255, 255, 0.085);
    border-radius: 0.9rem;
    padding: 0.95rem;
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .footer-trust-card:hover {
    border-color: rgba(228, 194, 122, 0.32);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-1px);
  }

  .footer-trust-icon {
    color: #e4c27a;
    border: 1px solid rgba(228, 194, 122, 0.26);
    background: rgba(228, 194, 122, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .footer-heading-rule {
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: 0.55rem;
    background: linear-gradient(90deg, #e4c27a, rgba(228, 194, 122, 0.15));
  }

  .footer-link {
    text-decoration-color: transparent;
  }

  .footer-link:hover {
    color: #fff;
    text-decoration-line: underline;
    text-decoration-color: rgba(228, 194, 122, 0.9);
  }

  .footer-signoff {
    position: relative;
    background:
      radial-gradient(38rem 8rem at 50% 0, rgba(62, 101, 151, 0.11), transparent 78%),
      rgba(4, 15, 29, 0.56);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .footer-signoff-rule {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #e4c27a;
  }

  .footer-signoff-rule::before,
  .footer-signoff-rule::after {
    content: '';
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgba(228, 194, 122, 0.48));
  }

  .footer-signoff-rule::after {
    background: linear-gradient(90deg, rgba(228, 194, 122, 0.48), transparent);
  }

  .footer-signoff-rule span {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    transform: rotate(45deg);
    border: 1px solid rgba(240, 210, 148, 0.86);
    background: rgba(228, 194, 122, 0.12);
    box-shadow: 0 0 14px rgba(228, 194, 122, 0.16);
  }

  .footer-pill {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 1px solid rgba(228, 194, 122, 0.18);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    color: #d7deea;
    background: rgba(255, 255, 255, 0.028);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  @media (min-width: 640px) {
    .footer-panel {
      padding: 1.5rem;
    }
  }

  @media (max-width: 639px) {
    .footer-editorial {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.014), transparent);
    }

    .footer-trust-card:hover {
      transform: none;
    }

    .footer-signoff {
      text-align: center;
    }

    .footer-signoff .footer-pill {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-trust-card,
    .footer-policy-link {
      transition: none;
    }
  }
</style>
