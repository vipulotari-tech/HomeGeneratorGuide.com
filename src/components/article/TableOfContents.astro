---
interface Item { id: string; label: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<nav aria-label="Table of contents" class="rounded-xl border border-[#e5e7eb] bg-[#f9fafb] p-5">
  <p class="text-sm font-semibold uppercase tracking-wider text-[#1e3a5f]">On this page</p>
  <ol class="mt-3 space-y-1 text-sm">
    {items.map((t) => (
      <li><a href={`#${t.id}`} class="block min-h-[32px] rounded px-2 py-1.5 leading-snug text-slate-600 underline-offset-4 hover:bg-white hover:text-[#1e3a5f] hover:underline">{t.label}</a></li>
    ))}
  </ol>
</nav>
