{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homegeneratorguide-production",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "homegeneratorguide.com/*",
      "zone_name": "homegeneratorguide.com"
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
