      <path d="M140 150 H168 V230 H196" stroke="#F5821F" stroke-width="3" fill="none" stroke-dasharray="7 5"/>
      <rect x="196" y="40" width="348" height="100" rx="8" fill="#f0fdf4" stroke="#2D7D46" stroke-width="2"/>
      <text x="212" y="66" font-size="14" font-weight="bold" fill="#14532d" font-family="sans-serif">PRIORITY — always on</text>
      <text x="212" y="90" font-size="13" fill="#14532d" font-family="sans-serif">Fridge · furnace blower · well pump · sump</text>
      <text x="212" y="110" font-size="13" fill="#14532d" font-family="sans-serif">Medical loads · internet + lights</text>
      <rect x="196" y="180" width="348" height="100" rx="8" fill="#fffbeb" stroke="#F5821F" stroke-width="2"/>
      <text x="212" y="206" font-size="14" font-weight="bold" fill="#78350f" font-family="sans-serif">MANAGED — sheds on surge</text>
      <text x="212" y="230" font-size="13" fill="#78350f" font-family="sans-serif">Water heater · dryer · 2nd AC · EV charger</text>
