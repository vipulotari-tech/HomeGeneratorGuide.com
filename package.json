{
  "name": "homegeneratorguide",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/build-site.mjs production",
    "build:production": "node tools/build-site.mjs production",
    "build:staging": "node tools/build-site.mjs staging",
    "preview": "npm run build:production && wrangler dev --ip 0.0.0.0",
    "preview:staging": "npm run build:staging && wrangler dev --config wrangler.staging.jsonc --ip 0.0.0.0",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "qa:browser": "node tools/qa-browser.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy --config wrangler.staging.jsonc",
    "deploy": "npm run build:production && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
