---
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
  firstColSticky?: boolean;
}
const { headers, rows, caption, firstColSticky = false } = Astro.props;
---
<div class="overflow-x-auto rounded-lg border border-[#e5e7eb]">
  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr class="bg-[#1e3a5f] text-white">
        {headers.map((h, i) => (
          <th scope="col" class={`px-4 py-3 font-semibold ${firstColSticky && i === 0 ? 'sticky left-0 bg-[#1e3a5f]' : ''}`}>{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-t border-[#e5e7eb] odd:bg-white even:bg-[#f9fafb]">
          {r.map((cell, ci) => (
            ci === 0
              ? <th scope="row" class={`px-4 py-3 font-semibold text-[#1e3a5f] ${firstColSticky ? 'sticky left-0 bg-inherit' : ''}`}>{cell}</th>
              : <td class="px-4 py-3 text-[#1f2937]">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
