---
const year = new Date().getFullYear();
const topics = [
  { href: '/sizing/', label: 'Generator Sizing' },
  { href: '/cost/', label: 'Generator Cost' },
  { href: '/brands/', label: 'Generator Brands' },
  { href: '/comparisons/', label: 'Brand Comparisons' },
  { href: '/installation/', label: 'Installation' },
  { href: '/maintenance/', label: 'Maintenance' },
  { href: '/guides/', label: 'Buying Guides' },
];
const legal = [
  { href: '/about/', label: 'About' },
  { href: '/editorial-policy/', label: 'Editorial Policy' },
  { href: '/affiliate-disclosure/', label: 'Affiliate Disclosure' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/disclaimer/', label: 'Disclaimer' },
  { href: '/contact/', label: 'Contact' },
];
---
<footer class="bg-[#1e3a5f] text-slate-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-white">Home<span class="text-orange-400">Generator</span>Guide</p>
      <p class="mt-2 text-sm font-medium text-slate-300">Independent guides for US homeowners.</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">We explain generator sizing, costs, installation, and maintenance in plain language so you can talk confidently with qualified local installers.</p>
    </div>
    <nav aria-label="Topic categories">
      <p class="text-sm font-semibold uppercase tracking-wider text-white">Topics</p>
      <ul class="mt-3 space-y-1 text-sm">
        {topics.map((t) => (<li><a href={t.href} class="inline-block min-h-[32px] py-1 text-slate-300 underline-offset-4 hover:text-white hover:underline">{t.label}</a></li>))}
      </ul>
    </nav>
    <nav aria-label="About and legal">
      <p class="text-sm font-semibold uppercase tracking-wider text-white">Company</p>
      <ul class="mt-3 space-y-1 text-sm">
        {legal.map((t) => (<li><a href={t.href} class="inline-block min-h-[32px] py-1 text-slate-300 underline-offset-4 hover:text-white hover:underline">{t.label}</a></li>))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-6xl space-y-2 px-4 py-6 text-xs leading-relaxed text-slate-400 sm:px-6">
      <p>© {year} HomeGeneratorGuide.com — Independent educational resource. All rights reserved.</p>
      <p>HomeGeneratorGuide is an independent educational resource and is not affiliated with any generator manufacturer.</p>
    </div>
  </div>
</footer>
