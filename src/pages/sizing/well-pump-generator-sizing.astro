  ]}
  sources={[
    { label: 'Champion Power Equipment Generator Wattage Chart (well-pump reference ranges)', href: 'https://www.championpowerequipment.com/generator-wattage-chart/', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'Generac: What size generator do I need?', href: 'https://www.generac.com/resources/home-management/what-size-generator-do-i-need/', type: 'Manufacturer', verified: '2026-10-04' },
