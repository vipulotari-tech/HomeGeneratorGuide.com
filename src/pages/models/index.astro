---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { MODEL_SPECS } from '../../data/model-specs';

const models = MODEL_SPECS;
const rating = (model: typeof models[number]) => {
  const lp = model.ratingsKw.LP;
  const ng = model.ratingsKw['Natural gas'];
  const bits = [];
  if (lp !== undefined) bits.push(lp + ' kW LP');
  if (ng !== undefined) bits.push(ng + ' kW NG');
  return bits.length ? bits.join(' / ') : (model.standbyRatingKw ? model.standbyRatingKw + ' kW standby' : 'See source record');
};
---
<CategoryLayout
  title={`${models.length} Exact Standby Generator Configurations`}
  description="Exact-model residential standby generator guides with manufacturer-linked fuel ratings, fuel-use test points, sound conditions, MSRP/package caveats, warranty scope, and source gaps."
  intro="These pages stay model-specific. We do not copy a fuel rating, transfer switch, price, sound figure, or warranty term from another model just because the brand name matches."
  cards={models.map((model) => ({
    href: '/models/' + model.slug + '/',
    title: model.brand + ' ' + model.modelId,
    description: model.displayName + ' — ' + rating(model) + '. Exact-source scope, package notes, warranty and missing-data limits.',
    category: 'Models',
    readingTime: '6 min read',
  }))}
>
  <div class="prose-hgg mt-10">
    <h2>{models.length} configurations across five manufacturers</h2><p>Package variants count separately where the switch scope differs. Coverage is not a claim that all fields or current inventory are verified. Read each record’s source dates, conflicts and missing fields.</p><h2>Why exact-model pages matter</h2>
    <p>A brand family can contain multiple fuels, output ratings, ATS bundles, controllers, engine sizes, warranty terms, and revisions. A dealer quote should identify the exact generator and transfer equipment so the source data you compare actually belongs to the equipment being proposed.</p>
    <p>Use these pages with the <a href="/comparisons/five-brand-standby-generator-comparison/">five-brand comparison</a> and the <a href="/cost/standby-generator-quote-checklist/">quote checklist</a>. The model pages are desk research, not independent product tests or reliability scores.</p>
  </div>
</CategoryLayout>
