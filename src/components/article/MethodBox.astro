---
interface Props { verified?: string; }
const { verified } = Astro.props;
---
<aside class="not-prose mt-6 rounded-xl border border-[#e5e7eb] bg-surface p-5" aria-label="Editorial method and limits">
  <p class="text-sm font-semibold uppercase tracking-wider text-primary">Editorial method & limits</p>
  <ul class="mt-2 space-y-1 text-sm leading-relaxed text-gray-600">
    <li>Manufacturer statements are distinguished from independent facts and our editorial interpretation.</li>
    <li>Linked sources are listed below; product details, laws, and utility requirements can change.</li>
    {verified && <li>Source links on this page were checked {verified}.</li>}
    <li>Estimates, when included, are labeled and are not quotes or guarantees.</li>
    <li>We do not claim hands-on product testing, licensed review, or installation experience.</li>
    <li>We do not accept generator-brand, dealer, or installer advertising or referral payments.</li>
  </ul>
  <a href="/editorial-policy/" class="mt-2 inline-flex min-h-[32px] items-center text-sm font-medium text-primary underline decoration-accent underline-offset-4">Editorial and corrections policy →</a>
</aside>
