---
import BrandLogo from './BrandLogo.astro';
const nav = [
  { href: '/sizing/', label: 'Sizing Guide' },
  { href: '/cost/', label: 'Cost Guide' },
  { href: '/brands/', label: 'Brands' },
  { href: '/comparisons/', label: 'Comparisons' },
  { href: '/installation/', label: 'Installation' },
  { href: '/maintenance/', label: 'Maintenance' },
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href);
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-primary text-white shadow-sm">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-2 px-4 py-2 sm:gap-4 sm:px-6">
    <a href="/" class="flex min-h-[44px] items-center gap-2.5" aria-label="HomeGeneratorGuide home">
      <BrandLogo inverse />
    </a>
    <nav class="hidden items-center gap-2 lg:flex" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={active(n.href) ? 'page' : undefined}
          class={`rounded-md border-b-2 border-transparent px-3 py-2.5 text-sm font-medium text-slate-200 transition-colors hover:bg-white/10 hover:text-white ${active(n.href) ? 'border-accent bg-white/10 text-white' : ''}`}
        >{n.label}</a>
      ))}
    </nav>
    <button
      id="menu-btn"
      class="inline-flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-md border border-white/30 text-white transition-colors hover:bg-white/10 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span id="menu-label" class="sr-only">Open navigation menu</span>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-white/10 bg-primary lg:hidden" aria-label="Mobile">
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-3 sm:px-6">
      {nav.map((n) => (
        <li>
          <a
            href={n.href}
            aria-current={active(n.href) ? 'page' : undefined}
            class={`block min-h-[44px] rounded-md border-l-2 border-transparent px-3 py-3 text-[15px] font-medium text-slate-200 hover:bg-white/10 hover:text-white ${active(n.href) ? 'border-accent bg-white/10 text-white' : ''}`}
          >{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  const label = document.getElementById('menu-label');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
    if (open) (nav?.querySelector('a') as HTMLElement | null)?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !nav?.classList.contains('hidden')) {
      nav?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      if (label) label.textContent = 'Open navigation menu';
      (btn as HTMLElement | null)?.focus();
    }
  });
</script>
