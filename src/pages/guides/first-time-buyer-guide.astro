    <figure class="not-prose my-6">
    <img src="/images/home-evening-backup.webp" alt="Suburban home glowing at dusk while the street goes dark — the standby promise" width="1792" height="1232" loading="lazy" decoding="async" class="w-full rounded-xl border border-[#e5e7eb]" />
