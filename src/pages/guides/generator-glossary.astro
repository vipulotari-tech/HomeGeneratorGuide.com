---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const toc = [
  { id: 'electrical', label: 'Electrical and transfer terms' },
  { id: 'performance', label: 'Ratings and performance terms' },
  { id: 'fuel', label: 'Fuel and site terms' },
  { id: 'planning', label: 'Reliability and code terms' },
];

const groups: { id: string; title: string; terms: [string, string][] }[] = [
  {
    id: 'electrical',
    title: 'Electrical and transfer terms',
    terms: [
      ['Automatic transfer switch (ATS)', 'Equipment that changes the connected load between utility and generator sources as part of a compatible system. The exact sensing, timing, neutral, service, and load-control arrangement depends on the switch and generator models.'],
      ['Manual transfer switch', 'A switch that requires a person to change between utility and generator power. Circuit coverage, rating, and operating steps are specific to the installed equipment.'],
      ['Panel interlock', 'A mechanical accessory intended for a compatible electrical panel and breaker arrangement. It is not universal; the exact panel/accessory compatibility, installation, and local approval must be checked.'],
      ['Backfeed', 'Electrical energy flowing toward a source or conductors that are not intended to be energized by the generator. CPSC warns not to connect a generator to house wiring by plugging it into a wall outlet; use properly installed transfer equipment.'],
      ['Load management / load shedding', 'A control strategy that may delay, sequence, or disconnect selected loads when system conditions require it. Which loads can be managed and how they behave depend on the exact equipment and configuration.'],
      ['Service-entrance-rated switch', 'Transfer equipment identified by its manufacturer for a particular service-entrance application. The rating does not by itself establish the switch’s compatibility with a specific panel or complete installation.'],
    ],
  },
  {
    id: 'performance',
    title: 'Ratings and performance terms',
    terms: [
      ['Kilowatt (kW)', 'A unit of real electrical power. A generator’s kW rating is only meaningful alongside the model, fuel, phase, voltage, and rating conditions.'],
      ['Kilovolt-ampere (kVA)', 'A unit of apparent electrical power. The relationship to real power depends on power factor; do not assume a universal conversion when comparing equipment.'],
      ['Power factor', 'The ratio of real power (kW) to apparent power (kVA) for an AC load under the stated conditions. Use the value or rating applicable to the specific generator or load.'],
      ['Standby rating', 'A manufacturer’s stated output rating for standby/emergency use under stated conditions. Definitions and overload capability can differ; for example, the cited Generac sheet says its listed standby rating has no overload capability. Check the exact model documentation.'],
      ['Locked-rotor amps (LRA)', 'A motor’s nameplate or manufacturer value associated with starting current. It may help describe motor-start demand, but LRA alone is not a complete generator-sizing calculation.'],
      ['Total harmonic distortion (THD)', 'A measure of harmonic content in an electrical waveform relative to its fundamental component, commonly expressed as a percentage. Test load and method matter; do not compare ratings without their stated conditions.'],
      ['dB(A)', 'A sound level expressed using A-weighting. Distance, microphone direction, operating mode, load, surroundings, and the manufacturer’s test method all affect whether two reported values can be compared.'],
      ['Exercise mode', 'A scheduled generator test or exercise operation. Timing, duration, speed, loading, and controller behavior vary by model and settings; use the current owner manual.'],
    ],
  },
  {
    id: 'fuel',
    title: 'Fuel and site terms',
    terms: [
      ['Fuel-specific output', 'The rated power a particular model publishes for a stated fuel and configuration. A natural-gas rating and an LP rating may differ; do not substitute one for the other.'],
      ['Dual-fuel standby generator', 'A standby model designed to operate on either of two specified fuels, commonly natural gas or LP. The chosen fuel, field configuration, output, fuel use, and supply requirements must be confirmed for that model.'],
      ['Fuel-consumption test point', 'A manufacturer-published fuel-use value at a stated load and test condition. It is not automatically a household average or a fuel-bill prediction.'],
      ['Fuel inlet pressure and flow', 'The pressure and volume available at the generator connection while operating. The exact model’s installation manual specifies requirements; a qualified installer or fuel provider must verify the supply under the proposed load.'],
      ['Site derating', 'A reduction in available output that may apply under environmental or installation conditions identified by the manufacturer. The conditions and calculation are model-specific; there is no universal percentage for every generator.'],
    ],
  },
  {
    id: 'planning',
    title: 'Reliability and code terms',
    terms: [
      ['SAIDI', 'System Average Interruption Duration Index: EIA describes it as the total duration of non-momentary interruptions experienced by an average customer in a year. It is a utility reliability measure, not a prediction for one home.'],
      ['SAIFI', 'System Average Interruption Frequency Index: EIA describes it as the number of interruptions in a year. Check the data notes and event-inclusion rules when comparing values.'],
      ['Authority Having Jurisdiction (AHJ)', 'The authority responsible for applying or enforcing relevant requirements in a particular location. The responsible office and adopted rules can vary by jurisdiction.'],
      ['National Electrical Code (NEC / NFPA 70)', 'A model electrical code published by NFPA. The edition adopted locally and any local amendments determine what applies; installation design and approval are not established by this glossary.'],
    ],
  },
];
---
<ArticleLayout
  title="Generator Glossary: 23 Terms with Source and Scope Notes"
  description="Plain-language definitions for generator transfer equipment, ratings, fuel data, reliability metrics, and electrical-code terms—without universal sizing or clearance rules."
  category="Guides" categoryHref="/guides/" updated="2026-10-04" verified="2026-10-04" readingTime="7 min read" toc={toc}
  takeaways={[
    'Model, fuel, electrical configuration, test conditions, and local requirements matter when interpreting generator terminology.',
    'A glossary definition does not replace the exact product manual, equipment listing, or professional installation assessment.',
    'Generic multipliers, clearance numbers, sound comparisons, and maintenance intervals should not be applied across all models.',
  ]}
  sources={[
    { label: 'Generac 22–28 kW official specification sheet', href: 'https://productmanuals.generac.com/api/manualfiles/G0073270/A0005151077/0', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'KOHLER/Rehlko G4-315 26RCA/26RCAL official specification sheet', href: 'https://techcomm.rehlko.com/techcomm/pdf/g4315.pdf', type: 'Manufacturer', verified: '2026-10-04' },
    { label: 'CPSC: portable-generator CO and fire safety guidance (2026)', href: 'https://www.cpsc.gov/Newsroom/News-Releases/2026/CPSC-Warns-of-Generator-Carbon-Monoxide-and-Fire-Hazards-Ahead-of-Hurricane-Season', type: 'Safety authority', verified: '2026-10-04' },
    { label: 'EIA: 2024 outage duration and reliability metric definitions', href: 'https://www.eia.gov/todayinenergy/detail.php?id=66744', type: 'Government', verified: '2026-10-04' },
    { label: 'NFPA 70: National Electrical Code information', href: 'https://www.nfpa.org/codes-and-standards/nfpa-70-standard-development/70', type: 'Standards organization', verified: '2026-10-04' },
  ]}
  related={[
    { href: '/sizing/what-size-generator-do-i-need/', title: 'Load-based sizing guide', description: 'A static worksheet and professional-review framework.', category: 'Sizing' },
    { href: '/comparisons/transfer-switch-vs-interlock/', title: 'Transfer switch vs. interlock', description: 'Review connection terminology and safety boundaries.', category: 'Comparisons' },
    { href: '/guides/us-power-outage-statistics/', title: 'U.S. outage statistics', description: 'Interpret EIA measures without treating them as home forecasts.', category: 'Guides' },
    { href: '/guides/natural-gas-vs-propane/', title: 'Natural gas vs. propane', description: 'Compare site supply and exact-model data.', category: 'Guides' },
  ]}
>
  <section id="how-to-use">
    <h2>How to use this glossary</h2>
    <p>These concise definitions explain common terms, not a specific design. Manufacturer values and code requirements can be model- and location-specific. Read the exact manual and ask a qualified local professional before making equipment or installation decisions.</p>
  </section>

  {groups.map((group) => (
    <section id={group.id}>
      <h2>{group.title}</h2>
      <dl>
        {group.terms.map(([term, definition]) => (
          <div class="mt-4 rounded-lg border border-[#e5e7eb] bg-white p-4">
            <dt class="font-semibold text-[#1e3a5f]">{term}</dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-gray-600">{definition}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <section id="cross-links">
    <h2>Continue with a specific question</h2>
    <p>For actual appliance input, use the <a href="/sizing/appliance-wattage-chart/">manufacturer-published generic wattage reference</a> only as a starting point, then obtain exact nameplate data. For model ratings, see the <a href="/brands/">brand data pages</a>; for safe operation, read the <a href="/guides/generator-safety-overview/">safety guide</a>.</p>
  </section>
</ArticleLayout>
