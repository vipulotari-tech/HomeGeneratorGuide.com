---
interface Item { id: string; label: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<nav aria-label="Table of contents" class="article-toc">
  <p class="article-toc-heading">In this guide</p>
  <ol>
    {items.map((item, index) => (
      <li>
        <a href={`#${item.id}`}>
          <span aria-hidden="true" class="article-toc-number">{String(index + 1).padStart(2, '0')}</span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ol>
  <a class="article-toc-return" href="#article-content">Start reading <span aria-hidden="true">↗</span></a>
</nav>
