---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
---
<BaseLayout
  title="Vipul Otari, Publisher & Research Editor"
  description="About Vipul Otari, publisher and research editor of HomeGeneratorGuide: independent standby-generator research method, focus areas, and corrections policy."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/about/', label: 'About' }, { label: 'Vipul Otari' }]} />
    <div class="mt-4 flex items-center gap-4">
      <span aria-hidden="true" class="flex h-16 w-16 items-center justify-center rounded-full bg-[#1e3a5f] text-2xl font-bold text-orange-400">V</span>
      <div>
        <h1 class="text-3xl font-bold text-[#1e3a5f]">Vipul Otari</h1>
        <p class="text-sm font-medium text-gray-600">Publisher & Research Editor, HomeGeneratorGuide</p>
      </div>
    </div>
    <div class="prose-hgg mt-6">
      <h2>What I do</h2>
      <p>I research home standby generators full-time for this site: reading manufacturer documentation and spec sheets, cross-checking government and safety sources, and turning it into plain-language guides for US homeowners. My focus areas are generator sizing methodology, installed-cost research, brand/warranty verification, and outage-preparedness planning.</p>
      <h2>What I am not</h2>
      <p>I am not a licensed electrician, electrical engineer, or generator installer, and nothing here is presented as professional trade work. Every installation article on this site directs electrical and gas work to properly licensed professionals — that boundary is deliberate.</p>
      <h2>How articles are produced</h2>
      <ul>
        <li>Specifications traced to manufacturer pages, support docs, or manuals, with verification dates.</li>
        <li>Prices published as labeled planning ranges, never as quotes.</li>
        <li>No manufacturer pays for placement, coverage, or conclusions — see the <a href="/editorial-policy/">editorial policy</a>.</li>
        <li>Errors: <a href="/contact/">send the page URL plus your source</a>; substantiated corrections ship promptly.</li>
      </ul>
      <h2>Start reading</h2>
    </div>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <ArticleCard href="/sizing/what-size-generator-do-i-need/" title="What Size Generator Do I Need?" description="The complete sizing walkthrough." category="Sizing" />
      <ArticleCard href="/cost/standby-generator-cost/" title="Standby Generator Cost (2026)" description="Installed ranges and line items." category="Cost" />
    </div>
    <p class="mt-6 text-sm text-gray-600">Site method: <a href="/about/" class="underline decoration-orange-400 underline-offset-4">About</a> · <a href="/editorial-policy/" class="underline decoration-orange-400 underline-offset-4">Editorial Policy</a> · <a href="/disclaimer/" class="underline decoration-orange-400 underline-offset-4">Disclaimer</a></p>
  </div>
</BaseLayout>
