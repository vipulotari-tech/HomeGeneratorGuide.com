---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ArticleCard from '../components/article/ArticleCard.astro';

interface Card { href: string; title: string; description: string; category?: string; readingTime?: string; }
interface Props {
  title: string;
  description: string;
  intro: string;
  cards: Card[];
}
const { title, description, intro, cards } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: title }]} />
    <h1 class="mt-4 text-3xl font-bold text-primary sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-3xl text-lg leading-relaxed text-gray-600">{intro}</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (<ArticleCard href={c.href} title={c.title} description={c.description} category={c.category} readingTime={c.readingTime} />))}
    </div>
    <slot />
  </div>
</BaseLayout>
