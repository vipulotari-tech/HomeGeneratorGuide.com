<CategoryLayout
  title="Generator Maintenance Guides"
  description="Keep your standby ready: owner checks, exercise cycles, battery care, service intervals, and storm preparation."
  intro="Standby readiness depends on the exact model’s maintenance schedule, battery condition, fluids, airflow, exercise behavior, environment, and timely professional service. These guides keep safe owner observations separate from technician work."
  cards={[
    { href: '/maintenance/model-service-schedules/', title: 'Model service schedules', description: 'Selected Generac and KOHLER manual intervals with document scope and gaps.', category: 'Maintenance', readingTime: '6 min read' },
    { href: '/maintenance/maintenance-log/', title: 'Printable maintenance log', description: 'Blank service record for model, hours, completed work and next due dates.', category: 'Maintenance', readingTime: '2 min read' },

    { href: '/maintenance/generator-maintenance-checklist/', title: 'Maintenance Checklist', description: 'Monthly, seasonal, and annual tasks with a printable-style log.', category: 'Maintenance', readingTime: '9 min read' },
