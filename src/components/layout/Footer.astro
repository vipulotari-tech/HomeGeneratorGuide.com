---
import BrandLogo from './BrandLogo.astro';
const groups=[['Plan',[['Planning tools','/planning/'],['Generator sizing','/sizing/'],['Installed costs','/cost/'],['Compare quotes','/planning/quotes/'],['Ownership costs','/planning/ownership/']]],['Research',[['Brands','/brands/'],['Exact models','/models/'],['Comparisons','/comparisons/'],['Buying guides','/guides/'],['Verified quote project','/cost/homeowner-quote-database/']]],['Install & own',[['Installation','/installation/'],['ATS & load management','/installation/automatic-transfer-switch-guide/'],['Permits & placement','/installation/permits-and-local-requirements/'],['Maintenance','/maintenance/'],['Safety','/guides/generator-safety-overview/']]],['Our standards',[['About','/about/'],['Editorial team','/editorial-team/'],['Editorial policy','/editorial-policy/'],['Source policy','/source-policy/'],['Review process','/review-process/'],['Corrections','/corrections-policy/'],['Research updates','/research-updates/'],['Contact','/contact/']]]];
---
<footer class="publication-footer"><div class="editorial-container"><div class="footer-intro"><a href="/" aria-label="HomeGeneratorGuide home"><BrandLogo inverse/></a><p>Clearer decisions for a major home investment. Manufacturer evidence, explicit assumptions, and uncertainty you can see.</p></div><div class="footer-groups">{groups.map(([label,links])=><nav aria-label={label as string}><h2>{label}</h2><ul>{(links as string[][]).map(([text,url])=><li><a href={url}>{text}</a></li>)}</ul></nav>)}</div><div class="footer-bottom"><p>© {new Date().getFullYear()} HomeGeneratorGuide · Technical professional review pending.</p><nav aria-label="Legal"><a href="/privacy-policy/">Privacy</a><a href="/terms-of-service/">Terms</a><a href="/affiliate-disclosure/">Funding & disclosure</a><a href="/disclaimer/">Disclaimer</a></nav></div></div></footer>
