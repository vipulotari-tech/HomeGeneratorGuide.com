---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested could not be found. Browse generator sizing, cost, brands, and installation guides." noindex={true}>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-orange-700">404</p>
    <h1 class="mt-2 text-4xl font-bold text-[#1e3a5f]">That page is out of power.</h1>
    <p class="mt-4 text-gray-600">It may have moved. Try one of these instead:</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-orange-600 px-6 font-semibold text-white hover:bg-orange-700">Homepage</a>
      <a href="/sizing/what-size-generator-do-i-need/" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-[#1e3a5f] px-6 font-semibold text-[#1e3a5f] hover:bg-slate-50">Sizing guide</a>
      <a href="/cost/standby-generator-cost/" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-[#e5e7eb] px-6 font-semibold text-gray-700 hover:bg-slate-50">Cost guide</a>
    </div>
  </div>
</BaseLayout>
