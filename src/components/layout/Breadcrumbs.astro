---
interface Crumb { href?: string; label: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-slate-600">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-slate-300">/</span>}
        {c.href && i < items.length - 1
          ? <a href={c.href} class="min-h-[32px] inline-flex items-center rounded px-0.5 underline-offset-4 hover:text-primary hover:underline">{c.label}</a>
          : <span aria-current="page" class="font-medium text-primary">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
