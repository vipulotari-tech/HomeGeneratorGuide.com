---
interface Item { q: string; a: string; }
interface Props { items: Item[]; headingLevel?: 'h2' | 'h3'; }
const { items, headingLevel = 'h2' } = Astro.props;
const Tag = headingLevel;
---
<section aria-labelledby="faq-heading" class="mt-10">
  <Tag id="faq-heading" class="text-2xl font-semibold text-primary">Frequently asked questions</Tag>
  <div class="mt-4 space-y-3">
    {items.map((f) => (
      <details class="group rounded-lg border border-[#e5e7eb] bg-white open:border-orange-300 open:bg-orange-50/40">
        <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-medium text-primary [&::-webkit-details-marker]:hidden">
          <span>{f.q}</span>
          <svg class="h-5 w-5 shrink-0 text-orange-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-4 pb-4 text-[15px] leading-relaxed text-gray-700">{f.a}</div>
      </details>
    ))}
  </div>
</section>
